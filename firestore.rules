rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'obahlog@gmail.com' ||
        request.auth.token.email == 'nuveronsystems@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string &&
        data.name is string && data.name.size() <= 100 &&
        data.email is string && data.email.size() <= 100 &&
        data.role in ['admin', 'teacher', 'student', 'parent'];
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: users can view and update their own profile; admins can manage all
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    // Admin lookup directory
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Announcements: anyone signed in can read; admins and teachers can create/update
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance records: teachers & admins can write; signed-in users can read
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // School configuration: read allowed for all; write allowed for admin
    match /school_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
